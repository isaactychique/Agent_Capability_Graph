<urn:acg:metadata:assertion/ann_56805cf79c0dd2187ef210f9> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/write%2Ffile> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L591> ;
    acg:evidenceText "Append text to the end of a file, creating the file if it does not exist. The existing content is never changed or replaced. The text is appended exactly as given, with no newline added before or after it, so end it with a newline if the next append should start on a new line. Only works within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange true .

<urn:acg:metadata:assertion/ann_772ddeb8cf013bfb13d4b9cd> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/copy%2Ffile> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L988> ;
    acg:evidenceText "Copy a file to a new location, without reading its content into the conversation. Copies one regular file, keeping its permissions and modification time; directories are not copied. If the destination exists, the operation will fail: it never overwrites. Both source and destination must be within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange true .

<urn:acg:metadata:assertion/ann_8b5cd8cd3a5d166babdc1b10> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/search%2Fweb> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fbrave%2Fbrave-search-mcp-server%2Fblob%2F2d15f633f7076791f4e9397429b09fcc79ae8609%2Fsrc%2Ftools%2Fweb%2Findex.ts%23L19> ;
    acg:evidenceText """Performs web searches using the Brave Search API and returns comprehensive search results with rich metadata.

    When to use:
        - General web searches for information, facts, or current topics
        - Location-based queries (restaurants, businesses, points of interest)
        - News searches for recent events or breaking stories
        - Finding videos, discussions, or FAQ content
        - Research requiring diverse result types (web pages, images, reviews, etc.)

    Returns a JSON list of web results with title, description, and URL.

    When the "results_filter" parameter is empty, JSON results may also contain FAQ, Discussions, News, and Video results.""" ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange false .

<urn:acg:metadata:assertion/ann_8eaead7a0a38366366ef416b> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/search%2Ffilesystem%20entry> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L1027> ;
    acg:evidenceText "Find files and directories by NAME, not by content: this tool never reads or searches inside files. It walks the tree under 'path' and matches a glob pattern against each entry's path relative to 'path' (case-sensitive). Use '*.ext' to match entries directly under 'path', and '**/*.ext' or '**/name' to match at any depth. Returns full paths to all matching items. Great for finding files when you don't know their exact location. Only searches within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange false .

<urn:acg:metadata:assertion/ann_9090e1581980b1f1a5cd82b2> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/create%2Fdirectory> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L664> ;
    acg:evidenceText "Create a new directory or ensure a directory exists. Can create multiple nested directories in one operation. If the directory already exists, this operation will succeed silently. Perfect for setting up directory structures for projects or ensuring required paths exist. Only works within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange true .

<urn:acg:metadata:assertion/ann_a67fcec0989be593b5941963> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/read%2Ffilesystem%20entry> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L1082> ;
    acg:evidenceText "Retrieve detailed metadata about a file or directory. Returns comprehensive information including size, creation time, last modified time, permissions, type and hard-link count. This tool is perfect for understanding file characteristics without reading the actual content. Only works within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange false .

<urn:acg:metadata:assertion/ann_a9460f11959d0666d3420c74> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/list%2Fdirectory> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L737> ;
    acg:evidenceText "List the files and directories directly inside a path with each file's size, marked [FILE] or [DIR], sorted by name or by size, largest first (sortBy). Use it when sizes matter, such as finding the largest files; for names only, use list_directory, which returns less text. Returns one line per entry, followed by the totals. Only works within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange false .

<urn:acg:metadata:assertion/ann_ebab1f63a4bb3d5bf52e85b5> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/write%2Ffile> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L625> ;
    acg:evidenceText "Make line-based edits to a text file. Edits apply in order, each to the result of the ones before it, and each replaces the first match of its oldText with newText. oldText must match the file's text exactly, except that line endings (LF or CRLF) never matter and, when there is no exact match, a run of whole lines matches if each line is equal once leading and trailing whitespace is ignored (newText then takes the file's indentation). Whitespace inside a line must match. If any edit has no match, nothing is written and the error shows the closest lines of the file, numbered, to copy oldText from. Returns a git-style diff showing the changes made. Only works within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange true .

<urn:acg:metadata:assertion/ann_faf18d0b1ea2bbd89343348d> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/read%2Ffile> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L406> ;
    acg:evidenceText "Read the complete contents of a file from the file system as text. Handles various text encodings and provides detailed error messages if the file cannot be read. Use this tool when you need to examine the contents of a single file. Use the 'head' parameter to read only the first N lines of a file, or the 'tail' parameter to read only the last N lines of a file. Operates on the file as text regardless of extension. Only works within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange false .

<urn:acg:metadata:assertion/ann_ff797ff7ca7a7a2a9d6e31ea> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/write%2Ffile> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L558> ;
    acg:evidenceText "Create a new file or completely overwrite an existing file with new content. Use with caution as it will overwrite existing files without warning. Handles text content with proper encoding. Only works within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange true .

<urn:acg:metadata:assertion/b7500baaf3810030d0e77f5c1ce4394c3e2b5851fa1a1f5a608cc6824ad7ba4a> a acg:CapabilityAssertion ;
