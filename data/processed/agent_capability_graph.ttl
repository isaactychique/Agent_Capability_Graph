<urn:acg:metadata:assertion/ann_02ad037dfe1e7778718c973c> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/list%2Fdirectory> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L856> ;
    acg:evidenceText "Get a recursive tree view of files and directories as a JSON structure. Each entry includes 'name', 'type' (file/directory), and 'children' for directories. Files have no children array, while directories always have a children array (which may be empty), except at the last level when 'depth' limits the tree: those directories are not read and have no children array. The output is formatted with 2-space indentation for readability. Only works within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange false .

<urn:acg:metadata:assertion/ann_05c695ead905de242b284d73> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/list%2Fdirectory> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L698> ;
    acg:evidenceText "List the files and directories directly inside a path, each marked [FILE] or [DIR]. Use it to see what a directory contains; when you also need each entry's size or want entries sorted by size, use list_directory_with_sizes instead, and for a recursive view use directory_tree. Returns one line per entry. Only works within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange false .

<urn:acg:metadata:assertion/ann_0f18efcb91f7ae585e574be7> a acg:CapabilityAssertion ;
    acg:assertedCapability <urn:acg:metadata:capability/move%2Ffilesystem%20entry> ;
    acg:assertionMethod acg:inferred ;
    acg:basedOnSource <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L947> ;
    acg:evidenceText "Move or rename files and directories. Can move files between directories and rename them in a single operation. If the destination exists, the operation will fail. Works across different directories and can be used for simple renaming within the same directory. Both source and destination must be within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange true .

<urn:acg:metadata:assertion/ann_1a38e844f5959d6e78bdcac3> a acg:CapabilityAssertion ;
