<urn:acg:metadata:tool/tool_0a2d9042a1d8e05a5e4bfc90> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "Read the contents of multiple files simultaneously. This is more efficient than reading files one by one when you need to analyze or compare multiple files. Each file's content is returned with its path as a reference. Failed reads for individual files won't stop the entire operation. Only works within allowed directories." ;
    schema:name "read_multiple_files" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L513> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_2796ee55630568d5f9775bd6> ;
    acg:inputSchemaDescription """z.object({
  paths: z
    .array(z.string())
    .min(1)
    .describe(
      "Array of file paths to read. Each path must be a string pointing to a valid file within allowed directories.",
    ),
})""" ;
    acg:readOnlyHint true ;
    acg:requiredParameter "paths" ;
    acg:schemaFormat "TypeScript/Zod" .

<urn:acg:metadata:tool/tool_12b29b22ce9f3a10a75e3b44> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "Make line-based edits to a text file. Edits apply in order, each to the result of the ones before it, and each replaces the first match of its oldText with newText. oldText must match the file's text exactly, except that line endings (LF or CRLF) never matter and, when there is no exact match, a run of whole lines matches if each line is equal once leading and trailing whitespace is ignored (newText then takes the file's indentation). Whitespace inside a line must match. If any edit has no match, nothing is written and the error shows the closest lines of the file, numbered, to copy oldText from. Returns a git-style diff showing the changes made. Only works within allowed directories." ;
    schema:name "edit_file" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L625> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_ebab1f63a4bb3d5bf52e85b5> ;
    acg:inputSchemaDescription """z.object({
  path: pathArg("The text file to edit"),
  edits: z
    .array(EditOperation)
    .describe(
      "The replacements to make, applied in order, each to the result of the ones before it. " +
        "If any one has no match, none is written.",
    ),
  dryRun: z
    .boolean()
    .default(false)
    .describe("Preview changes using git-style diff format"),
})""" ;
    acg:readOnlyHint false ;
    acg:requiredParameter "edits",
        "path" ;
    acg:schemaFormat "TypeScript/Zod" .

<urn:acg:metadata:tool/tool_14cdd492bc35caea7c42ed95> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "Move or rename files and directories. Can move files between directories and rename them in a single operation. If the destination exists, the operation will fail. Works across different directories and can be used for simple renaming within the same directory. Both source and destination must be within allowed directories." ;
    schema:name "move_file" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L947> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_0f18efcb91f7ae585e574be7> ;
    acg:inputSchemaDescription """z.object({
  source: pathArg("The file or directory to move or rename"),
  destination: pathArg(
    "Its new path, including the name; nothing may exist there yet",
  ),
})""" ;
    acg:readOnlyHint false ;
    acg:requiredParameter "destination",
        "source" ;
    acg:schemaFormat "TypeScript/Zod" .

<urn:acg:metadata:tool/tool_17d1387e08fdb516f8ae9ea4> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "Append text to the end of a file, creating the file if it does not exist. The existing content is never changed or replaced. The text is appended exactly as given, with no newline added before or after it, so end it with a newline if the next append should start on a new line. Only works within allowed directories." ;
    schema:name "append_file" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L591> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_56805cf79c0dd2187ef210f9> ;
    acg:inputSchemaDescription """z.object({
  path: pathArg("The file to append to; it is created if it does not exist"),
  content: z
    .string()
    .describe(
      "Text to append, exactly as given. No newline is added: end it with \\\\n if the next append should start on a new line.",
    ),
})""" ;
    acg:readOnlyHint false ;
    acg:requiredParameter "content",
        "path" ;
    acg:schemaFormat "TypeScript/Zod" .

<urn:acg:metadata:tool/tool_227a22914b6b80aecf236e37> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "Get a recursive tree view of files and directories as a JSON structure. Each entry includes 'name', 'type' (file/directory), and 'children' for directories. Files have no children array, while directories always have a children array (which may be empty), except at the last level when 'depth' limits the tree: those directories are not read and have no children array. The output is formatted with 2-space indentation for readability. Only works within allowed directories." ;
    schema:name "directory_tree" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L856> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_02ad037dfe1e7778718c973c> ;
    acg:inputSchemaDescription """z.object({
  path: pathArg("The directory at the root of the tree"),
  excludePatterns: z
    .array(z.string())
    .optional()
    .default([])
    .describe(
      "Patterns for entries to leave out, with their contents, matched against each entry's path relative to path. " +
        "A pattern with no '*' matches that name at any depth ('node_modules' leaves out every node_modules directory); " +
        "a pattern with '*' is a glob matched as written, and one ending in '/**' also leaves out the directory it names.",
    ),
  depth: z
    .number()
    .int()
    .positive()
    .optional()
    .describe(
      "How many levels to descend: 1 lists only the entries directly in path. " +
        "Directories at the last level have no children array. Omit for the whole tree.",
    ),
})""" ;
    acg:readOnlyHint true ;
    acg:requiredParameter "path" ;
    acg:schemaFormat "TypeScript/Zod" .

<urn:acg:metadata:tool/tool_39708785a11e937f811b0318> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "List the files and directories directly inside a path, each marked [FILE] or [DIR]. Use it to see what a directory contains; when you also need each entry's size or want entries sorted by size, use list_directory_with_sizes instead, and for a recursive view use directory_tree. Returns one line per entry. Only works within allowed directories." ;
    schema:name "list_directory" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L698> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_05c695ead905de242b284d73> ;
    acg:inputSchemaDescription """z.object({
  path: pathArg("The directory to list"),
})""" ;
    acg:readOnlyHint true ;
    acg:requiredParameter "path" ;
    acg:schemaFormat "TypeScript/Zod" .

<urn:acg:metadata:tool/tool_7ac9a3d7ab03c83851ae7dd2> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "Create a new directory or ensure a directory exists. Can create multiple nested directories in one operation. If the directory already exists, this operation will succeed silently. Perfect for setting up directory structures for projects or ensuring required paths exist. Only works within allowed directories." ;
    schema:name "create_directory" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L664> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_9090e1581980b1f1a5cd82b2> ;
    acg:inputSchemaDescription """z.object({
  path: pathArg(
    "The directory to create, with any missing parents; an existing directory is left as is",
  ),
})""" ;
    acg:readOnlyHint false ;
    acg:requiredParameter "path" ;
    acg:schemaFormat "TypeScript/Zod" .

<urn:acg:metadata:tool/tool_888ed052cecd843c39ee7d63> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "Retrieve detailed metadata about a file or directory. Returns comprehensive information including size, creation time, last modified time, permissions, type and hard-link count. This tool is perfect for understanding file characteristics without reading the actual content. Only works within allowed directories." ;
    schema:name "get_file_info" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L1082> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_a67fcec0989be593b5941963> ;
    acg:inputSchemaDescription """z.object({
  path: pathArg("The file or directory to describe"),
})""" ;
    acg:readOnlyHint true ;
    acg:requiredParameter "path" ;
    acg:schemaFormat "TypeScript/Zod" .

<urn:acg:metadata:tool/tool_a45f242b10cf1d48472f6001> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "List the files and directories directly inside a path with each file's size, marked [FILE] or [DIR], sorted by name or by size, largest first (sortBy). Use it when sizes matter, such as finding the largest files; for names only, use list_directory, which returns less text. Returns one line per entry, followed by the totals. Only works within allowed directories." ;
    schema:name "list_directory_with_sizes" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L737> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_a9460f11959d0666d3420c74> ;
    acg:inputSchemaDescription """z.object({
  path: pathArg("The directory to list"),
  sortBy: z
    .enum(["name", "size"])
    .optional()
    .default("name")
    .describe("Sort entries by name or size"),
})""" ;
    acg:readOnlyHint true ;
    acg:requiredParameter "path" ;
    acg:schemaFormat "TypeScript/Zod" .

<urn:acg:metadata:tool/tool_b272d8f5a87dd532b55d7eb9> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "Copy a file to a new location, without reading its content into the conversation. Copies one regular file, keeping its permissions and modification time; directories are not copied. If the destination exists, the operation will fail: it never overwrites. Both source and destination must be within allowed directories." ;
    schema:name "copy_file" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L988> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_772ddeb8cf013bfb13d4b9cd> ;
    acg:inputSchemaDescription """z.object({
  source: z.string().describe("The file to copy"),
  destination: z
    .string()
    .describe("Where to create the copy; nothing may exist there yet"),
})""" ;
    acg:readOnlyHint false ;
    acg:requiredParameter "destination",
        "source" ;
    acg:schemaFormat "TypeScript/Zod" .

<urn:acg:metadata:tool/tool_dd2d903d3540ea7e7ba10dd8> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "Read a file and return it as a base64-encoded content block with its MIME type. Image and audio files are returned as image/audio content; any other file type is returned as an embedded resource. Only works within allowed directories." ;
    schema:name "read_media_file" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L430> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_1a38e844f5959d6e78bdcac3> ;
    acg:inputSchemaDescription """z.object({
  path: pathArg("The image, audio or other file to read as base64"),
})""" ;
    acg:readOnlyHint true ;
    acg:requiredParameter "path" ;
    acg:schemaFormat "TypeScript/Zod" .

<urn:acg:metadata:tool/tool_e9bf440a996899c1be8481d5> a acg:MCPTool ;
    prov:wasDerivedFrom <urn:acg:corpus:registry> ;
    schema:description "Read the complete contents of a file as text. DEPRECATED: Use read_text_file instead." ;
    schema:name "read_file" ;
    acg:documentedBy <urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L388> ;
    acg:hasCapabilityAssertion <urn:acg:metadata:assertion/ann_34286638e98161e0fc2722bf> ;
    acg:inputSchemaDescription """z.object({
  path: pathArg("The file to read as text"),
  tail: z
    .number()
    .int()
    .min(0)
    .optional()
    .describe("If provided, returns only the last N lines of the file"),
  head: z
    .number()
    .int()
    .min(0)
    .optional()
    .describe("If provided, returns only the first N lines of the file"),
})""" ;
    acg:readOnlyHint true ;
    acg:requiredParameter "path" ;
    acg:schemaFormat "TypeScript/Zod" .

