    acg:evidenceText "List the files and directories directly inside a path, each marked [FILE] or [DIR]. Use it to see what a directory contains; when you also need each entry's size or want entries sorted by size, use list_directory_with_sizes instead, and for a recursive view use directory_tree. Returns one line per entry. Only works within allowed directories." ;
    acg:evidenceType "inferred_from_static_registration" ;
    acg:requiresAuthentication "unknown" ;
    acg:reviewStatus "candidate_for_human_review" ;
    acg:stateChange false .

