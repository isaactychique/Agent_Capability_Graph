<urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L1117> a prov:Entity,
        acg:SourceDocument ;
    schema:url <https://github.com/modelcontextprotocol/servers/blob/e1dc4b18dbb948921da37f3d4224a628730b43b0/src/filesystem/server.ts#L1117> ;
    acg:revision "e1dc4b18dbb948921da37f3d4224a628730b43b0" .

<urn:acg:metadata:source/https%3A%2F%2Fgithub.com%2Fmodelcontextprotocol%2Fservers%2Fblob%2Fe1dc4b18dbb948921da37f3d4224a628730b43b0%2Fsrc%2Ffilesystem%2Fserver.ts%23L388> a prov:Entity,
