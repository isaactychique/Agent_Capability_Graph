@prefix acg: <urn:acg:ontology:> .
@prefix shape: <urn:acg:shapes:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Minimum shared contract: optional metadata remains optional.
shape:Entity a sh:NodeShape ;
    sh:targetClass acg:MCPServer, acg:MCPTool, acg:AgentSkill ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:path schema:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ; sh:minLength 1 ] ;
    sh:property [ sh:path acg:documentedBy ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class acg:SourceDocument ] ;
    sh:property [ sh:path acg:hasCapabilityAssertion ; sh:class acg:CapabilityAssertion ; sh:nodeKind sh:IRI ] .

shape:Server a sh:NodeShape ;
    sh:targetClass acg:MCPServer ; sh:targetSubjectsOf acg:exposesTool ;
    sh:class acg:MCPServer ;
    sh:property [ sh:path acg:exposesTool ; sh:class acg:MCPTool ; sh:nodeKind sh:IRI ] .

shape:Tool a sh:NodeShape ; sh:targetClass acg:MCPTool ;
    sh:property [ sh:path [ sh:inversePath acg:exposesTool ] ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:class acg:MCPServer ; sh:nodeKind sh:IRI ] .

shape:Source a sh:NodeShape ; sh:targetClass acg:SourceDocument ; sh:nodeKind sh:IRI ;
    sh:property [ sh:path schema:url ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:pattern "^https?://" ] .

shape:Capability a sh:NodeShape ; sh:targetClass acg:Capability ; sh:nodeKind sh:IRI ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:nodeKind sh:Literal ; sh:minLength 1 ] .

shape:Assertion a sh:NodeShape ; sh:targetClass acg:CapabilityAssertion ; sh:nodeKind sh:IRI ;
    sh:property [ sh:path acg:assertedCapability ; sh:minCount 1 ; sh:maxCount 1 ; sh:class acg:Capability ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path acg:assertionMethod ; sh:minCount 1 ; sh:maxCount 1 ; sh:in (acg:sourceDeclared acg:curatorMapped acg:inferred) ] ;
    sh:property [ sh:path acg:basedOnSource ; sh:minCount 1 ; sh:class acg:SourceDocument ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path [ sh:inversePath acg:hasCapabilityAssertion ] ; sh:minCount 1 ;
        sh:or ( [ sh:class acg:MCPServer ] [ sh:class acg:MCPTool ] [ sh:class acg:AgentSkill ] ) ] .

# A candidate is not a human-reviewed classification.
shape:Assertion sh:property [
    sh:path acg:reviewStatus ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ("candidate_for_human_review" "reviewed")
] ; sh:property [ sh:path acg:derivedFromAssertion ; sh:class acg:CapabilityAssertion ] .

shape:Capability sh:property [ sh:path acg:capabilityAction ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path acg:capabilityObject ; sh:minCount 1 ; sh:maxCount 1 ] .

shape:DerivedClaim a sh:NodeShape ;
    sh:targetSubjectsOf acg:derivedFromAssertion ;
    sh:property [ sh:path acg:assertionMethod ; sh:hasValue acg:inferred ] ;
    sh:sparql [
        sh:message "A server claim must be supported by a claim for the same task on one of its exposed tools."@en ;
        sh:select """
            PREFIX acg: <urn:acg:ontology:>
            SELECT $this ?value WHERE {
                $this acg:derivedFromAssertion ?value ; acg:assertedCapability ?capability .
                FILTER NOT EXISTS {
                    ?server acg:hasCapabilityAssertion $this ; acg:exposesTool ?tool .
                    ?tool acg:hasCapabilityAssertion ?value .
                    ?value acg:assertedCapability ?capability .
                }
            }
        """
    ] .

@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
shape:SkillFact a sh:NodeShape ; sh:targetClass acg:SkillFactAssertion ;
    sh:property [ sh:path [ sh:inversePath acg:hasSkillFactAssertion ] ; sh:minCount 1 ; sh:maxCount 1 ; sh:class acg:AgentSkill ] ;
    sh:property [ sh:path acg:factKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("format_mention" "requirement_statement" "installation_instruction") ] ;
    sh:property [ sh:path acg:factValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path acg:basedOnSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:class acg:SourceDocument ] ;
    sh:property [ sh:path acg:reviewStatus ; sh:hasValue "candidate_for_human_review" ; sh:maxCount 1 ] ;
    sh:property [ sh:path acg:evidenceType ; sh:hasValue "skill_body" ; sh:maxCount 1 ] .

shape:LocatedEvidence a sh:NodeShape ; sh:targetSubjectsOf acg:contentSha256 ;
    sh:property [ sh:path acg:contentSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path acg:evidenceLine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path acg:evidenceStart ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:lessThan acg:evidenceEnd ] ;
    sh:property [ sh:path acg:evidenceEnd ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
    sh:property [ sh:path acg:evidenceText ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] .

# LLM assertions must select from the published fixed-v1 scheme.
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
shape:FixedVocabularyLLM a sh:NodeShape ; sh:targetSubjectsOf acg:llmModel ;
    sh:class acg:CapabilityAssertion ;
    sh:property [ sh:path acg:assertedCapability ; sh:node [
        sh:property [ sh:path skos:inScheme ; sh:hasValue <urn:acg:vocabulary:v1:scheme> ]
    ] ] ;
    sh:property [ sh:path acg:reviewStatus ; sh:hasValue "candidate_for_human_review" ] ;
    sh:property [ sh:path acg:evidenceType ; sh:hasValue "llm_fixed_vocabulary" ] ;
    sh:property [ sh:path acg:contentSha256 ; sh:minCount 1 ] .
