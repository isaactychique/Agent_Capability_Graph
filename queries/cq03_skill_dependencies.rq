# CQ03 — See competency_questions.md for the atomic question.
PREFIX acg: <urn:acg:ontology:>
PREFIX schema: <https://schema.org/>

SELECT DISTINCT ?skill ?skillName ?dependency WHERE {
 VALUES ?skillName { __NAME__ }
 ?skill a acg:AgentSkill ; schema:name ?skillName ; acg:dependency ?dependency .
} ORDER BY ?skillName ?dependency
