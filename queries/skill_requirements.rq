PREFIX acg: <urn:acg:ontology:>
PREFIX schema: <https://schema.org/>

# Pass --name to select a Skill. Missing fields remain unbound;
# they must not be interpreted as proof that the Skill has no requirement.
SELECT DISTINCT ?skillName ?dependency ?compatibility ?allowedTool
                ?hasScripts ?hasReferences ?hasAssets ?evidence
WHERE {
  VALUES ?skillName { __NAME__ }
  ?skill a acg:AgentSkill ;
         schema:name ?skillName ;
         acg:documentedBy ?source .
  ?source schema:url ?evidence .
  OPTIONAL { ?skill acg:dependency ?dependency }
  OPTIONAL { ?skill acg:compatibility ?compatibility }
  OPTIONAL { ?skill acg:allowedTool ?allowedTool }
  OPTIONAL { ?skill acg:hasScripts ?hasScripts }
  OPTIONAL { ?skill acg:hasReferences ?hasReferences }
  OPTIONAL { ?skill acg:hasAssets ?hasAssets }
}
ORDER BY ?skillName ?dependency
